{
  "name": "@froq/ui",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "packageManager": "pnpm@10.15.0",
  "description": "froq's UI library: shared logic and a token contract, several styles.",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./core": "./src/core/index.ts",
    "./vue": "./src/vue/index.ts",
    "./paper": "./src/paper/index.ts",
    "./paper/style.css": "./src/paper/style.css",
    "./paper/tokens.css": "./src/paper/tokens.css",
    "./flat": "./src/flat/index.ts",
    "./flat/style.css": "./src/flat/style.css",
    "./flat/tokens.css": "./src/flat/tokens.css",
    "./term": "./src/term/index.ts",
    "./term/style.css": "./src/term/style.css",
    "./term/tokens.css": "./src/term/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter playground build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "check:tokens": "jiti scripts/check-tokens.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm check:tokens"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "jiti": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vue": "catalog:prod",
    "vue-tsc": "catalog:dev"
  }
}
