{
  "name": "@froq/ui",
  "version": "0.1.0",
  "private": false,
  "description": "froq's UI library: shared logic, a token contract, and the components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0froq/ui.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/style.css",
    "./tokens.css": "./src/tokens.css",
    "./core": "./src/core/index.ts",
    "./vue": "./src/vue/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "generate": "pnpm --filter docs generate",
    "build": "pnpm --filter docs generate",
    "deploy": "pnpm generate && cf deploy",
    "preview": "pnpm --filter docs preview",
    "preview:deploy": "pnpm generate && cf previews deploy",
    "lint": "vp lint --config .oxlintrc.json .",
    "lint:fix": "vp lint --config .oxlintrc.json . --fix",
    "fmt": "vp fmt --config .oxfmtrc.json .",
    "fmt:check": "vp fmt --config .oxfmtrc.json . --check",
    "typecheck": "vue-tsc --noEmit && pnpm --filter docs typecheck",
    "check:tokens": "jiti scripts/check-tokens.ts",
    "check": "vp run lint && vp run fmt:check && vp run typecheck && vp run check:tokens",
    "prepare": "npx simple-git-hooks"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "reka-ui": "^2.10.5"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "cf": "catalog:dev",
    "jiti": "catalog:dev",
    "lint-staged": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:dev",
    "vue": "catalog:prod",
    "vue-tsc": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "vp lint --config .oxlintrc.json --fix --no-error-on-unmatched-pattern",
      "vp fmt --config .oxfmtrc.json --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": "^24.21.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
